# Copy to .env on the VPS (never commit .env).
# Postgres on host, published as 127.0.0.1:55432 → use host.docker.internal from the container.

DATABASE_URL=postgresql://ultra_app:CHANGE_ME@host.docker.internal:55432/ultra_copy

# Optional: only if you split accounting DB later (not required for PR #21 merged routes).
# ACCOUNTS_DATABASE_URL=

PORT=3000

# Must match your existing VPS shared network name (see: docker network ls).
DOCKER_NETWORK=shared
